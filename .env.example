# ─────────────────────────────────────────────────────────────────────────────
# Enterprise Data Platform — environment template
# Copy to .env and fill in values. NEVER commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── GCP ───────────────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=

# ── Kafka consumer (src/ingestion/kafka_consumer.py — low-volume/edge topics) ─
KAFKA_BOOTSTRAP_SERVERS=broker1:9092,broker2:9092
# Security: SASL_SSL (recommended for Confluent Cloud / prod), SSL, PLAINTEXT (local dev only)
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_API_KEY=your-api-key
KAFKA_API_SECRET=your-api-secret

KAFKA_SCHEMA_REGISTRY_URL=https://schema-registry.example.com
KAFKA_SCHEMA_REGISTRY_AUTH=your-sr-key:your-sr-secret

GCS_BUCKET_NAME=edp-bronze-raw

# JSON list of TopicConfig dicts:
# [{"topic":"payments","group_id":"edp-payments","gcs_prefix":"bronze/payments",
#   "dlq_topic":"payments.dlq","schema_subject":"payments-value"}]
KAFKA_TOPIC_CONFIG_JSON=[]

# Batch tuning
CONSUMER_BATCH_SIZE=5000
CONSUMER_BATCH_TIMEOUT_MS=5000

# ── Bronze streaming job (src/processing/bronze_streaming.py) ─────────────────
# JSON list of topic specs:
# [{"topic":"payments","schema_subject":"payments-value","gcs_prefix":"bronze/payments",
#   "starting_offsets":"earliest","reader_schema_mode":"latest"}]
BRONZE_TOPICS_JSON=[]
BRONZE_TRIGGER_INTERVAL=30 seconds
BRONZE_AVAILABLE_NOW=false          # true = one-shot backfill mode
BRONZE_QUARANTINE_ENABLED=true

# ── Silver processing job (src/processing/bronze_to_silver.py) ────────────────
# JSON list of job specs:
# [{"name":"payments_silver","source_path":"gs://bucket/bronze/payments",
#   "target_path":"gs://bucket/silver/payments","primary_keys":["payment_id"],
#   "order_column":"_kafka_timestamp_ms","scd_type":1,
#   "required_columns":["amount_cents"]}]
SILVER_JOBS_JSON=[]
SILVER_TRIGGER_INTERVAL=1 minute
SILVER_AVAILABLE_NOW=false          # true = backfill run

# ── Table maintenance (src/maintenance/table_optimization.py) ─────────────────
# JSON list: [{"path":"gs://bucket/silver/payments","z_order_by":["customer_id"],
#              "partition_filter":"event_date >= current_date() - 3"}]
OPTIMIZE_TABLES_JSON=[]
VACUUM_RETENTION_HOURS=168          # 7-day floor protects time travel + concurrent readers
VACUUM_DRY_RUN=true                 # flip false only with a reviewed ticket

# ── Data quality framework (src/validation/data_quality.py) ───────────────────
DQ_SUITES_DIR=./src/validation/expectations
DQ_SLACK_WEBHOOK_URL=
DQ_PAGERDUTY_KEY=
DQ_BQ_PROJECT=your-project-id
DQ_BQ_DATASET=data_quality_monitoring
DQ_RAISE_ON_FAILURE=true
DQ_REPORTS_DIR=/tmp/dq_reports
# Optional: upload validation reports to GCS instead of local-only
DQ_REPORTS_GCS_BUCKET=

# ── Pipeline monitor (src/observability/pipeline_monitor.py) ──────────────────
MONITOR_BQ_PROJECT=your-project-id
MONITOR_BQ_DATASET=pipeline_monitoring
MONITOR_PD_KEY=
MONITOR_SLACK_URL=
MONITOR_SLA_JSON=
MONITOR_Z_THRESHOLD=3.0
MONITOR_STALE_RUN_MINUTES=120
